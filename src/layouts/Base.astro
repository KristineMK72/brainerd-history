---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const site = "https://brainerd-history.vercel.app";
const {
  title = "Brainerd — A Crossing on the Mississippi",
  description = "A visual history of Brainerd, Minnesota: Ojibwe homelands, railroad town, Gull Lake resorts, Paul Bunyan Land, BIR, and the ice.",
} = Astro.props;
const image = `${site}/og.jpg`;
const imageSquare = `${site}/og-square.jpg`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#07140e" />
    <link rel="canonical" href={site} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Brainerd — A Crossing on the Mississippi" />
    <meta property="og:url" content={site} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Brainerd, 1870 — A Crossing on the Mississippi, with the talking Paul Bunyan statue" />
    <meta property="og:image" content={imageSquare} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="1200" />
    <link rel="image_src" href={image} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content="Brainerd — A Crossing on the Mississippi" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;1,9..144,400&family=Outfit:wght@400;500;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;1,8..60,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="grain"></div>
    <header class="nav">
      <a class="brand" href="#top">Brainerd · 1870</a>
      <ul class="nav-links">
        <li><a href="#origins">Origins</a></li>
        <li><a href="#hole">Hole-in-the-Day</a></li>
        <li><a href="#rails">Rails</a></li>
        <li><a href="#lakes">Lakes</a></li>
        <li><a href="#resorts">Resorts</a></li>
        <li><a href="#paul">Paul</a></li>
        <li><a href="#bir">BIR</a></li>
        <li><a href="#ice">Ice</a></li>
      </ul>
    </header>
    <slot />
  </body>
</html>
