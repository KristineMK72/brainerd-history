  ["1805", "Pike on Christmas Day", "Lt. Zebulon Pike camps near the future townsite."],
  ["1836", "Gull Lake village", "Bagone-giizhig the Elder moves his band to Gull Lake and founds the Mississippi Ojibwe community the treaties later treat as central."],
  ["1868", "June 27 on the road", "Bagone-giizhig the Younger is assassinated near Crow Wing. Crow Wing Village withers; Brainerd is platted two years later."],
  ["1870", "The Crossing is chosen", "Northern Pacific picks a Mississippi crossing. Directors name it Brainerd on October 1."],
  ["1934", "Paul Bunyan Inc.", "Merrill and Louise Cragun register a company to sell central Minnesota as vacation country."],
