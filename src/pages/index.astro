---
import Base from "../layouts/Base.astro";

const img = {
  pines: "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=1600&q=80",
  steam: "https://images.unsplash.com/photo-1544620341-11cb2cd7c6d5?auto=format&fit=crop&w=1600&q=80",
  cabin: "https://images.unsplash.com/photo-1470770841072-f971736a00c3?auto=format&fit=crop&w=1600&q=80",
  lake: "https://images.unsplash.com/photo-1501785888041-af3ef285b470?auto=format&fit=crop&w=1800&q=80",
  chain: "https://images.unsplash.com/photo-1469474968028-56623f02e42e?auto=format&fit=crop&w=1800&q=80",
  dock: "https://images.unsplash.com/photo-1506905925346-21bda4d32df4?auto=format&fit=crop&w=1600&q=80",
  tower: "https://upload.wikimedia.org/wikipedia/commons/e/e8/Brainerd_Water_Tower.jpg",
  ice: "https://images.unsplash.com/photo-1483664852095-d6cc8591bf29?auto=format&fit=crop&w=1800&q=80",
  cars: "https://images.unsplash.com/photo-1541447271487-09612b3f4d20?auto=format&fit=crop&w=1600&q=80",
};

const years = ["1805 Pike", "1870 The Crossing", "1929 Madden's begins", "1940 Cragun cabins", "1968 Donnybrooke", "1982 NHRA Nationals", "1991 Ice Extravaganza", "1950 Paul Bunyan"];

const people = [
  ["Jack & Jim Madden", "Gull Lake resort men", "Jack leased a failing Depression-era golf course in 1932 for $500. He wired the owner he had no money; the owner sold it anyway, nothing down. With brother Jim he built Madden's into a peninsula still run by family."],
  ["Merrill & Louise Cragun", "Paul Bunyan Inc.", "In 1934 they registered Paul Bunyan Inc. to sell the Brainerd Lakes. With Jack Madden they staged the first Paul Bunyan event in 1936. In 1940 they bought seven acres on a swampy Gull Lake hill."],
  ["Dutch & Irma Cragun", "A legend on the lake", "Dutch took over in 1957, added hot water, a heated pool, year-round rooms, and championship golf. In 2025 he sold to a Baxter hospitality group after 85 family years."],
  ["George Montgomery", "Donnybrooke builder", "Retired Northwest pilot who carved a 3-mile road course south of North Long Lake in 1968."],
  ["Jerry Hansen", "BIR's second life", "Bought the foreclosed track in 1973 and renamed it Brainerd International Raceway."],
  ["C. Elmer Anderson", "Governor of Minnesota", "Born in Brainerd in 1912. Governor 1951-55, later mayor of the city that raised him."],
  ["Charles Albert Bender", "Hall of Fame pitcher", "Born in Crow Wing County in 1884. 212 wins, three World Series titles."],
  ["Lyman P. White", "Father of Brainerd", "Land-company agent who arrived by stage in 1870."],
  ["Zane Smith", "Bank clerk, 1933", "Walked into First National as Baby Face Nelson's gang held it."],
];

const events = [
  ["1875", "The Crossing collapses", "The wooden Mississippi trestle gave way under a freight train. Four people died."],
  ["1933", "Baby Face in the lobby", "Nelson's gang took about $32,000 from First National and left firing into the lobby."],
  ["1964", "Fire at Madden's", "The clubhouse and new O'Madden Pub burned opening night. They rebuilt bigger."],
  ["1982", "NHRA comes north", "First North Star Nationals. 50,000 fans. Shirley Muldowney won Top Fuel. Paul Newman won his first pro race here the same year."],
  ["1991", "Ice Extravaganza", "Jaycees sketched a winter contest on a beer case. It became the world's largest charitable ice derby."],
  ["2025", "Cragun's sale", "Dutch Cragun sold the resort after 85 years in the family."],
];

const timeline = [
  ["1805", "Pike on Christmas Day", "Lt. Zebulon Pike camps near the future townsite."],
  ["1870", "The Crossing is chosen", "Northern Pacific picks a Mississippi crossing."],
  ["1929", "Pine Beach Hotel", "Madden's dates its founding to the Roberts hotel and golf course."],
  ["1932", "Jack Madden leases the course", "$500 a season, then a no-money-down purchase."],
  ["1936", "First Paul Bunyan event", "Merrill Cragun and Jack Madden stage a parade to sell the lakes."],
  ["1940", "Cragun cabins", "Merrill and Louise buy seven acres on Gull Lake."],
  ["1957", "Dutch takes the keys", "Merrill Cragun Jr. becomes manager."],
  ["1968", "Donnybrooke", "George Montgomery cuts a 3-mile course."],
  ["1973", "BIR is born", "Jerry Hansen buys and renames the track."],
  ["1982", "NHRA Nationals", "First national drag event at BIR."],
  ["1991", "Ice Extravaganza", "Jaycees put 10,000 anglers on Hole-in-the-Day Bay."],
  ["2025", "Cragun's changes hands", "Sold to Leisure Hotels and Resorts of Baxter."],
];
---

<Base>
  <section class="hero" id="top">
    <img class="hero-media" src={img.chain} alt="Northern lake country at dusk" />
    <div class="hero-copy wrap">
      <p class="eyebrow reveal">A history of the crossing</p>
      <h1 class="reveal delay-1">Railroad town. Lake town. Race town.</h1>
      <p class="lede reveal delay-2">Brainerd started where steel met the Mississippi. It stayed because Gull Lake turned a weekend into a century of family resorts, ice holes, and a racetrack in the pines.</p>
      <p class="scroll-cue">Scroll the century</p>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee-track">{[...years, ...years].map((y) => <span>{y} *</span>)}</div>
  </div>

  <section class="chapter paper" id="origins">
    <span class="chapter-num">01</span>
    <div class="wrap split">
      <div>
        <p class="kicker">Chapter I</p>
        <h2>A river already named</h2>
        <div class="prose">
          <p>The land that became Brainerd was Ojibwe territory. Crow Wing Village near Fort Ripley was the earlier meeting place. Zebulon Pike camped here on Christmas Day, 1805. What changed everything was a railroad that needed to cross the Mississippi.</p>
        </div>
      </div>
      <figure class="photo">
        <img src={img.pines} alt="Pine forest in northern light" />
        <figcaption class="caption">The city-of-pines before the shops.</figcaption>
      </figure>
    </div>
  </section>

  <section class="chapter" id="rails">
    <span class="chapter-num">02</span>
    <div class="wrap split">
      <figure class="photo">
        <img src={img.steam} alt="Steam locomotive at a historic station" />
        <figcaption class="caption">A town built so locomotives could cross and be repaired.</figcaption>
      </figure>
      <div>
        <p class="kicker">Chapter II · 1870</p>
        <h2>Named in a boardroom</h2>
        <div class="prose">
          <p>Northern Pacific president John Gregory Smith chose a crossing seven miles north of Crow Wing. On October 1, 1870, directors named it Brainerd. The wooden trestle opened March 8, 1871. By the 1920s nine in ten households lived off the railroad shops. When the shops shrank, the lakes had to become the payroll.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="film" aria-label="Photographs of the lakes and town">
    <figure>
      <img src={img.tower} alt="Brainerd concrete water tower" />
      <figcaption class="caption">The 1918-21 water tower — Paul Bunyan's flashlight</figcaption>
    </figure>
    <figure>
      <img src={img.lake} alt="Gull Lake chain shoreline and pines" />
      <figcaption class="caption">Gull Lake country — the chain that kept the town after the trains</figcaption>
    </figure>
    <figure>
      <img src={img.dock} alt="Lake at dusk" />
      <figcaption class="caption">Resort light on a north-country shore</figcaption>
    </figure>
    <figure>
      <img src={img.ice} alt="Frozen northern lake in winter" />
      <figcaption class="caption">The same water in January — Ice Extravaganza weather</figcaption>
    </figure>
  </section>

  <section class="chapter paper" id="lakes">
    <span class="chapter-num">03</span>
    <div class="wrap split">
      <div>
        <p class="kicker">The chain</p>
        <h2>Gull Lake is why people stay</h2>
        <div class="prose">
          <p>More than 460 lakes sit within 25 miles of Brainerd. The one that made the letterhead is Gull — a many-armed lake north of town, chained to Round, Love, and the bays cabin families memorize like streets.</p>
          <p>Hole-in-the-Day Bay is named for the Ojibwe leader Bagone-giizhig. In summer it is docks and golf. In January it becomes a temporary city of 10,000 anglers.</p>
        </div>
      </div>
      <figure class="photo">
        <img src={img.chain} alt="Lake chain among forested hills" />
        <figcaption class="caption">Water and pine — the Gull Lake look.</figcaption>
      </figure>
    </div>
  </section>

  <section class="chapter" id="resorts">
    <span class="chapter-num">04</span>
    <div class="wrap">
      <p class="kicker">Neighbors on the peninsula</p>
      <h2>The Maddens and the Craguns</h2>
      <div class="prose" style="max-width:46rem">
        <p>Two University of Minnesota ad-desk friends — Jack Madden and Merrill Cragun Sr. — helped invent Brainerd as a vacation. In 1936 they put on the town's first Paul Bunyan parade. Then they built resorts within waving distance on Gull Lake.</p>
      </div>
      <div class="grid-2">
        <article class="card">
          <p class="meta">Madden's on Gull Lake · since 1929</p>
          <h3>Nothing down, ten years to pay</h3>
          <p>Jack Madden summered at the Roberts Pine Beach Hotel in 1931. He leased the failing golf course for $500, then bought it with no money down. With brother Jim he built Mission Point, the Madden Inn, Voyageur rooms, and The Classic. Deb (Madden) Thuringer passed it to Ben Thuringer and Abbey Pieper. Fourth generation on the same peninsula.</p>
        </article>
        <article class="card">
          <p class="meta">Cragun's Resort · 1940-2025 in the family</p>
          <h3>A swamp, a gamble</h3>
          <p>Merrill and Louise bought seven acres in 1940. Dutch called it a hill that sloped down to a marsh. By 1947 they had a lodge and twelve cabins. Dutch took over in 1957, married Irma, and built 54 holes of golf. In 2025, at 93, he sold to Leisure Hotels and Resorts in Baxter. The name on the lake stayed.</p>
        </article>
      </div>
      <figure class="photo" style="margin-top:1.8rem;min-height:320px">
        <img src={img.cabin} alt="Lakeside pines and still water" style="min-height:320px" />
        <figcaption class="caption">The product they sold in 1936 is still the product: water, pine, and a week that feels longer than it is.</figcaption>
      </figure>
    </div>
  </section>

  <section class="chapter paper" id="bir">
    <span class="chapter-num">05</span>
    <div class="wrap split">
      <div>
        <p class="kicker">Donnybrooke · 1968</p>
        <h2>A racetrack in the jack pine</h2>
        <div class="prose">
          <p>George Montgomery wanted somewhere to race his Shelby 427 Cobra. He cut a 3.1-mile course through woods on North Long Lake and named it Donnybrooke for two Minnesota road racers killed at Road America.</p>
          <p>The first event in July 1968 was an NHRA drag race won by Doc Halladay. Can-Am followed. Foreclosure hit in 1973. Jerry Hansen bought it and renamed it Brainerd International Raceway. Paul Newman set a lap record in 1977 and won his first pro race here in 1982 — the year 50,000 fans came for the first NHRA nationals. The Copham family bought the track in 2006 to keep it from becoming lots.</p>
        </div>
      </div>
      <figure class="photo">
        <img src={img.cars} alt="Race cars on a starting grid" />
        <figcaption class="caption">BIR still runs road course and drag strip on the same property.</figcaption>
      </figure>
    </div>
  </section>

  <section class="chapter" id="ice">
    <span class="chapter-num">06</span>
    <div class="wrap split">
      <figure class="photo">
        <img src={img.ice} alt="Wide frozen lake under winter sky" />
        <figcaption class="caption">Hole-in-the-Day Bay in January — a city that lasts three hours.</figcaption>
      </figure>
      <div>
        <p class="kicker">Gull Lake · every January</p>
        <h2>The Ice Fishing Extravaganza</h2>
        <div class="prose">
          <p>In 1990 Brainerd Jaycees sketched a winter event on a beer case. The first contest ran in 1991. It is billed as the world's largest charitable ice-fishing tournament.</p>
          <p>Volunteers drill thousands of holes on Hole-in-the-Day Bay. More than 10,000 anglers walk out. For three hours the county's largest city is on the ice. Most of the money goes to Confidence Learning Center — more than $3 million since the start. Thin ice has moved it to Round Lake more than once.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="chapter paper" id="events">
    <div class="wrap">
      <p class="kicker">The years people retell</p>
      <h2>From trestle to Zoo camp</h2>
      <div class="grid-2">
        {events.map(([meta, title, text]) => (
          <article class="card"><p class="meta">{meta}</p><h3>{title}</h3><p>{text}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="chapter" id="people">
    <div class="wrap">
      <p class="kicker">Faces of the crossing</p>
      <h2>People the town remembers</h2>
      <div class="grid-3">
        {people.map(([name, role, text]) => (
          <article class="card"><p class="meta">{role}</p><h3>{name}</h3><p>{text}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="chapter paper" id="timeline">
    <div class="wrap">
      <p class="kicker">A longer century</p>
      <h2>Timeline</h2>
      <div class="timeline">
        {timeline.map(([year, title, text]) => (
          <div class="t-item"><div class="year">{year}</div><div><h3>{title}</h3><p class="prose">{text}</p></div></div>
        ))}
      </div>
    </div>
  </section>

  <section class="chapter">
    <div class="wrap">
      <p class="kicker">Still here</p>
      <h2>What remains</h2>
      <div class="prose">
        <p>Madden's is still a family peninsula. Cragun's still says Gull Lake on the sign. BIR still shakes the pines in August. Every winter the Jaycees still ask the ice if it will hold.</p>
      </div>
      <div class="stat-row">
        <div class="stat"><b>1870</b><span>Railroad town founded</span></div>
        <div class="stat"><b>10k+</b><span>Anglers on Gull in January</span></div>
        <div class="stat"><b>85 yrs</b><span>Craguns on the lake</span></div>
        <div class="stat"><b>4 gen</b><span>Maddens still on the peninsula</span></div>
      </div>
    </div>
  </section>

  <footer>
    <div class="wrap">
      <p>Built with Astro. <a href="https://github.com/KristineMK72/brainerd-history">GitHub</a> · <a href="https://brainerd-history.vercel.app">Live site</a></p>
      <p style="margin-top:0.8rem">Sources: Crow Wing County Historical Society; Madden's and Cragun's official histories; BIR; Jaycees Ice Extravaganza reporting; Brainerd Dispatch. Landscape photos are Unsplash stand-ins; the water tower is Wikimedia.</p>
    </div>
  </footer>
</Base>
