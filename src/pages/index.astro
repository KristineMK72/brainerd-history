const events = [
  ["1868", "The road to Crow Wing", "Bagone-giizhig the Younger was shot near the Gull River outlet on June 27, on his way to fight removal to White Earth. The bay on Gull still carries his English name."],
  ["1875", "The Crossing collapses", "The wooden Mississippi trestle gave way under a freight train. Four people died. The railroad rebuilt in iron and the shops became the town's paycheck."],
  ["1933", "Baby Face in the lobby", "On October 23, Nelson's gang took about $32,000 from First National and left firing into the lobby. Clerk Zane Smith lived to tell it."],
  ["1936", "Paul Bunyan sells the lakes", "Merrill Cragun and Jack Madden put a giant in a parade so city people would book a cabin. The advertising outlived the railroad shops."],
