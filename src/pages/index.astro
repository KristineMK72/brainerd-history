  <section class="chapter paper" id="people">
    <div class="wrap">
      <p class="kicker">Faces of the crossing</p>
      <h2>People the town remembers</h2>
      <div class="grid-3">
        {people.map(([name, role, text]) => (
          <article class="card"><p class="meta">{role}</p><h3>{name}</h3><p>{text}</p></article>
        ))}
      </div>
